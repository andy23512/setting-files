### docker compose

function dc() {
	if [[ "$(git_repo)" == "[website]" ]]; then
		./bin/dc -f docker-compose.yaml -f docker-compose.dev.yaml $@
	elif [ -e "dev.yaml" ]; then
		docker compose -f docker-compose.yaml -f dev.yaml $@
	else
		docker compose $@
	fi
}
